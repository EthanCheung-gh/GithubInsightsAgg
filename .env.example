# SQLite 数据库位置（相对仓库根解析，目录不存在时自动创建）
DATABASE_URL="file:./data/insights.db"

# GitHub Personal Access Token（需 repo 权限才能读 traffic）。
# 留空时会依次回退：gh auth token -> 演示数据（mode = demo）。
GITHUB_TOKEN=""

# 采集节流间隔（毫秒），默认 80
GITHUB_MIN_INTERVAL_MS="80"

# 可选：GitHub OAuth App 的 Client ID，用于应用内「一键授权获取 Token」（Device Flow）。
# 只需 Client ID，不需要 Client Secret。留空则设置页自动降级为「手动创建 Token」引导。
GITHUB_OAUTH_CLIENT_ID=""
